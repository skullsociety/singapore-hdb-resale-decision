{
  "manifest_version": 3,
  "name": "Property Listing Collector",
  "version": "1.2.0",
  "description": "Save supported property listing cards to the local PropertyProject database.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:8771/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://www.propertyguru.com.sg/hdb-for-sale*"],
    "js": ["sites.js", "collector.js"],
    "run_at": "document_idle"
  }]
}
